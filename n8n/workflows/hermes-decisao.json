    {
      "id": "39e23cd3-8e24-44cb-b0a5-91aae769ee29",
      "name": "Monta o e-mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One e-mail for the batch, one link per proposal. The link carries the row id and its\n// token; the form only updates a row whose token matches and that is still 'proposed'.\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst rows = $input.all().map((i) => i.json).filter((r) => r && r.id);\nif (rows.length === 0) return [];\nconst blocks = rows.map((r) => {\n  const e = r.evidence ?? {};\n  const url = 'https://encorpa-fashion.pikapod.net/form/hermes-decisao?id=' + encodeURIComponent(r.id) + '&t=' + encodeURIComponent(r.decision_token);\n  return '<h3>' + esc(r.code ?? 'Proposta') + ' · ' + esc(r.target) + (e.severidade ? ' · ' + esc(e.severidade) : '') + '</h3>' +\n    '<p><b>O quê:</b> ' + esc(e.o_que ?? r.rationale) + '</p>' +\n    (e.por_que ? '<p><b>Por quê:</b> ' + esc(e.por_que) + '</p>' : '') +\n    (e.objetivo ? '<p><b>Objetivo:</b> ' + esc(e.objetivo) + '</p>' : '') +\n    '<p><a href=\"' + url + '\">Aprovar ou recusar esta proposta</a></p>';\n});\nreturn [{ json: {\n  ids: rows.map((r) => r.id),\n  subject: 'Hermes: ' + rows.length + (rows.length === 1 ? ' proposta' : ' propostas') + ' para decidir',\n  html: '<p>O Hermes leu as conversas e propôs as mudanças abaixo. Nada foi aplicado.</p>' +\n    '<p><b>Aprovar</b> manda implementar, testar e publicar sozinho se todos os testes passarem. ' +\n    '<b>Recusar</b> com o motivo ensina o Hermes a não propor de novo.</p>' + blocks.join('<hr>')\n} }];"
      }
    },
