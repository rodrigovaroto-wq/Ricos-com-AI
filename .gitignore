data/
backups/
screenshots/
traces/

# Logs e artefatos de teste
*.log
npm-debug.log*
coverage/
playwright-report/
test-results/

# Configuração local de negócio (o .example é versionado)
config/business.json

# Claude Code — settings do desenvolvedor. O settings.json carrega um bloco
# `env` e é criado a partir do .example, que é o versionado.
.claude/settings.json
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

