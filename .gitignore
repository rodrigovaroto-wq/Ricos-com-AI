.pnp.js

# Build
dist/
build/
.next/
out/

# Ambiente — nunca commitar segredos
.env
.env.*
!.env.example

# Sessão de navegador (cookies do Instagram)
.chrome-profile/

# Banco local
*.db
*.sqlite
*.sqlite3

# Dados e artefatos de execução — o PROMPT.md exige todos aqui. Os screenshots
