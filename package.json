{
  "name": "encorpa-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/dev/simulate.ts",
    "dev:conversas": "tsx src/dev/run-conversations.ts",
    "dev:personas": "tsx src/dev/persona-run.ts",
    "typecheck:function": "deno check supabase/functions/turn/index.ts supabase/functions/whatsapp/index.ts",
    "dev:estoque": "tsx src/dev/availability.ts",
    "dev:placar": "tsx src/dev/persona-scorecard.ts",
    "dev:n8n": "tsx src/dev/n8n-sync.ts",
    "dev:gates": "tsx src/dev/gate-diff.ts",
    "dev:regua": "tsx src/dev/ruler-sim.ts",
    "dev:painel": "tsx src/dev/painel.ts",
    "deploy:turn": "tsx src/dev/deploy-turn.ts",
    "hermes": "tsx src/dev/hermes-run.ts",
    "hermes:calibrar": "tsx src/dev/hermes-calibrate.ts",
    "dev:eval": "tsx src/dev/persona-eval.ts",
    "verificar:guardas": "tsx src/dev/verify-guards.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  }
}
